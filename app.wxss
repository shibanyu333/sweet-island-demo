/* The existing brand intro is retained; a skip action is always available. */
.splash { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: #fff7df; overflow: hidden; animation: splash-surface 320ms ease-out both; }
.splash-skip { position: absolute; right: 32rpx; top: 175rpx; z-index: 2; width: 120rpx; min-width: 120rpx; height: 88rpx; padding: 0; border: 1rpx solid #c8b8a5; background: transparent; color: #a25238; font-size: 24rpx; white-space: nowrap; }
.splash-inner { width: 100%; text-align: center; padding: 50rpx 34rpx 0; }
.splash-emblem { color: #75533c; font-size: 58rpx; line-height: 1; animation: splash-mark 550ms cubic-bezier(.16,1,.3,1) both; }
.splash-brand { font-size: 54rpx; font-weight: 750; letter-spacing: 6rpx; margin-top: 22rpx; animation: splash-type 500ms 100ms ease-out both; }
.splash-en { font-size: 18rpx; letter-spacing: 3rpx; color: #786351; margin-top: 12rpx; animation: splash-type 650ms 180ms ease-out both; }
.splash-art { height: 340rpx; margin: 30rpx auto 18rpx; width: 340rpx; overflow: hidden; animation: splash-cake 700ms 100ms cubic-bezier(.16,1,.3,1) both; }
.splash-slogan { font-size: 28rpx; animation: splash-type 550ms 600ms ease-out both; }
.splash-line { width: 48rpx; height: 2rpx; background: #b69668; margin: 24rpx auto 18rpx; animation: splash-type 550ms 680ms ease-out both; }
.splash-caption { font-size: 22rpx; color: #786351; animation: splash-type 550ms 750ms ease-out both; }
.splash-leaving { animation: splash-exit 260ms ease-in both; }
@keyframes splash-surface { from { opacity: 0; } to { opacity: 1; } }
@keyframes splash-mark { from { opacity: 0; transform: rotate(-25deg) scale(.7); } to { opacity: 1; transform: rotate(0) scale(1); } }
@keyframes splash-type { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes splash-cake { from { opacity: 0; transform: translateY(38rpx) scale(.92) rotate(-3deg); } to { opacity: 1; transform: translateY(0) scale(1) rotate(0); } }
@keyframes splash-exit { from { opacity: 1; } to { opacity: 0; transform: translateY(-16rpx); } }
@media (prefers-reduced-motion: reduce) {
  .splash, .splash-inner, .splash-emblem, .splash-brand, .splash-en, .splash-art, .splash-slogan, .splash-line, .splash-caption { animation: none; }
  .splash-leaving { opacity: 0; }
}
