/* One visual system. No platform mini-button sizing for quantity controls. */
page { background: #fffaf2; color: #513e32; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", Arial, sans-serif; font-size: 28rpx; line-height: 1.5; }
view, text, button, input, image, scroll-view, picker { box-sizing: border-box; }
image { display: block; }
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: inherit;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: normal;
}
button::after { border: 0; }
button[disabled] { opacity: .45; }
input { font: inherit; color: inherit; }
.app { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
.app.with-cart { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.page { padding: 8rpx 32rpx 32rpx; }
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  height: 166rpx;
  padding: 80rpx 32rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffaf2;
}
.wordmark { display: flex; align-items: center; min-height: 68rpx; font-size: 30rpx; font-weight: 750; letter-spacing: 2rpx; }
.brand-symbol { width: 58rpx; height: 58rpx; margin-right: 10rpx; }
.brand-en, .eyebrow, .section-en, .title-flower { display: none; }
.capsule { display: flex; align-items: center; justify-content: space-evenly; width: 150rpx; height: 54rpx; border: 1rpx solid #ddd8cf; border-radius: 30rpx; font-size: 28rpx; background: #fff; }
.capsule-divider { color: #ddd8cf; font-size: 24rpx; }
.store-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0 24rpx; }
.store-name { font-size: 28rpx; font-weight: 600; }
.store-note { display: flex; align-items: center; color: #786351; font-size: 22rpx; margin-top: 6rpx; }
.green-dot { width: 9rpx; height: 9rpx; margin-right: 8rpx; border-radius: 50%; background: #78916d; }
.sep { margin: 0 10rpx; }
.brown-button { background: #a25238; color: #fffdf8; border: 2rpx solid #91452e; border-radius: 44rpx; min-height: 88rpx; padding: 20rpx 28rpx; font-size: 27rpx; font-weight: 650; }
.small-button { min-height: 76rpx; padding: 15rpx 22rpx; font-size: 24rpx; }
.small-button text { margin-left: 12rpx; }
.outline-button { background: #fffdf8; border: 2rpx solid #dac4a6; border-radius: 40rpx; color: #885038; }
.wide { display: flex; width: 100%; margin: 26rpx 0 8rpx; }
.quick-grid { display: flex; margin: 20rpx 0 28rpx; border: 1rpx solid #e7e1d7; border-radius: 14rpx; background: #fff; }
.quick-item { display: flex; align-items: center; width: 50%; min-height: 116rpx; padding: 20rpx; position: relative; }
.quick-item + .quick-item { border-left: 1rpx solid #e7e1d7; }
.quick-item > image, .stamp-mini, .quick-arrow { display: none; }
.quick-title { font-size: 27rpx; font-weight: 600; }
.quick-sub { font-size: 21rpx; color: #786351; margin-top: 5rpx; }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 30rpx; font-weight: 600; margin: 28rpx 0 20rpx; }
.text-link { font-size: 23rpx; font-weight: 400; color: #786351; padding: 10rpx 0; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-card { width: calc(50% - 10rpx); margin-bottom: 20rpx; border: 1rpx solid #e7e1d7; border-radius: 14rpx; overflow: hidden; background: #fff; }
.product-image-wrap { height: 254rpx; position: relative; background: #f4eee4; }
.product-image { width: 100%; height: 100%; }
.product-badge { position: absolute; top: 14rpx; left: 14rpx; padding: 4rpx 10rpx; border-radius: 6rpx; background: #fffaf2; color: #735638; font-size: 19rpx; }
.product-body { padding: 18rpx; }
.product-name { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.product-sub { font-size: 23rpx; color: #786351; margin-top: 6rpx; line-height: 1.6; }
.home .product-sub { display: none; }
.product-bottom { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 8rpx; gap: 8rpx; }
.price, .numeric, .stat-number, .big-price, .recharge-amount, .point-count, .stamp, .reward-number, .order-code, .cart-price, .bag-count, .quantity-value, .detail-price {
  font-family: inherit;
  font-style: normal;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}
.price { display: inline-block; flex-shrink: 0; font-size: 34rpx; line-height: 1.3; font-weight: 600; white-space: nowrap; }
.currency { font-size: 24rpx; margin-right: 3rpx; }
.home-qty { color: #786351; font-size: 21rpx; white-space: nowrap; }
.quantity { display: flex; flex-shrink: 0; align-items: center; }
.quantity-value { display: block; width: 44rpx; min-width: 44rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; font-weight: 500; white-space: nowrap; }
.add-button, .minus-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-grow: 0;
  flex-shrink: 0;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
}
.quantity-disc { position: relative; width: 60rpx; height: 60rpx; border-radius: 44% 48% 42% 46%; background: #a25238; }
.quantity-line { position: absolute; width: 24rpx; height: 3rpx; border-radius: 2rpx; left: 18rpx; top: 28.5rpx; background: #fff; pointer-events: none; }
.quantity-line-vertical { transform: rotate(90deg); }
.minus-button .quantity-disc { border: 1rpx solid #c8b8a5; background: #fffdf8; border-radius: 44% 48% 42% 46%; }
.minus-button .quantity-line { background: #a25238; left: 17rpx; top: 27.5rpx; }
.control-pressed { opacity: .65; }
.recharge-banner { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx; margin: 12rpx 0 22rpx; border-radius: 14rpx; background: #f2ead9; }
.banner-title { font-size: 27rpx; font-weight: 600; margin-bottom: 5rpx; }
.banner-arrow { font-size: 34rpx; flex-shrink: 0; }
.muted { font-size: 23rpx; color: #786351; line-height: 1.65; }
.home-footer { text-align: center; font-size: 22rpx; color: #786351; padding: 16rpx 0; }
.home-footer > text { display: none; }
.page-heading { padding: 14rpx 0 22rpx; }
.page-title { font-size: 36rpx; line-height: 1.4; font-weight: 650; margin: 8rpx 0 10rpx; }
.search-field { display: flex; align-items: center; padding: 8rpx 24rpx; border-radius: 40rpx; background: #f6f0e3; border: 1rpx solid #e5d7bf; margin-bottom: 18rpx; }
.search-field > text { font-size: 32rpx; color: #786351; margin-right: 12rpx; }
.search-field > input { flex: 1; width: 0; min-width: 0; height: 64rpx; background: transparent; border: 0; font-size: 25rpx; outline: none; }
.category-scroll { width: 100%; }
.categories { display: flex; white-space: nowrap; border-bottom: 1rpx solid #e7e1d7; }
.category { display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 20rpx 18rpx; min-height: 88rpx; font-size: 24rpx; border-bottom: 3rpx solid transparent; color: #786351; }
.category.selected { color: #a25238; border-bottom-color: #a25238; font-weight: 650; }
.menu-note { padding: 16rpx 0; font-size: 22rpx; color: #786351; }
.menu-product { display: flex; align-items: flex-start; gap: 22rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e7e1d7; }
.menu-product > image { width: 180rpx; height: 180rpx; border-radius: 12rpx; flex-shrink: 0; }
.menu-product-content { flex: 1; min-width: 0; }
.menu-product .product-sub { font-size: 23rpx; }
.menu-product .product-bottom { margin-top: 6rpx; }
.tiny-tag { display: inline-block; font-size: 19rpx; padding: 3rpx 9rpx; border-radius: 5rpx; background: #f1eadc; color: #735638; margin-bottom: 6rpx; }
.menu-product .tiny-tag { display: none; }
.detail-chevron { color: #887866; margin-left: 4rpx; }
.footnote { font-size: 21rpx; color: #786351; margin: 22rpx 0; text-align: center; line-height: 1.7; }
.tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; display: flex; height: calc(124rpx + env(safe-area-inset-bottom)); padding: 10rpx 12rpx env(safe-area-inset-bottom); border-top: 1rpx solid #e6d7c0; background: #fffdf8; }
.tab { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; color: #786351; font-size: 21rpx; }
.nav-icon { display: flex; align-items: center; justify-content: center; height: 54rpx; width: 76rpx; margin-bottom: 4rpx; border-radius: 28rpx; }
.nav-icon > image { width: 40rpx; height: 40rpx; opacity: .65; }
.tab.active { color: #8a452e; font-weight: 650; }
.tab.active image { opacity: 1; }
.cart-bar { position: fixed; bottom: calc(140rpx + env(safe-area-inset-bottom)); left: 24rpx; right: 24rpx; height: 100rpx; border: 2rpx solid #68513a; border-radius: 52rpx; background: #65503d; color: #fffdf8; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 10rpx 12rpx 10rpx 26rpx; z-index: 41; }
.cart-bar > view { display: flex; align-items: center; min-width: 0; gap: 12rpx; }
.bag-count { font-size: 24rpx; color: #e2d5c6; white-space: nowrap; }
.bag-count::after { content: '件'; font-size: 20rpx; margin-left: 4rpx; }
.cart-price { font-size: 33rpx; font-weight: 600; white-space: nowrap; }
.cart-note { display: none; }
.cart-bar > button { background: #f6e8be; color: #5d432e; min-height: 76rpx; font-size: 25rpx; padding: 14rpx 22rpx; border-radius: 40rpx; flex-shrink: 0; }
.stamp-card { position: relative; background: #fff3d8; border: 2rpx solid #dfc39e; border-radius: 30rpx; padding: 28rpx; margin: 10rpx 0 28rpx; }
.stamp-card-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-title { font-size: 30rpx; font-weight: 600; }
.point-count { font-size: 44rpx; line-height: 1.2; font-weight: 600; white-space: nowrap; }
.point-count > text { font-size: 25rpx; color: #786351; margin-left: 6rpx; font-weight: 400; }
.stamps { display: flex; flex-wrap: wrap; margin: 28rpx -4rpx 12rpx; }
.stamp-cell { width: 20%; display: flex; align-items: center; flex-direction: column; min-height: 120rpx; padding: 0 4rpx; }
.stamp { position: relative; width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #c6a887; border-radius: 44% 48% 46% 42%; background: #fffdf5; font-size: 27rpx; font-weight: 500; color: #887159; }
.stamp.reward { background: #f4dec2; border-color: #bf9569; color: #61472f; }
.stamp.filled { background: #fffaf0; border: 2rpx solid #b99869; color: #734a30; }
.stamp-cell > text { min-height: 30rpx; font-size: 20rpx; color: #786351; margin-top: 8rpx; }
.stamp-card-foot { font-size: 22rpx; color: #786351; padding-top: 18rpx; border-top: 2rpx dashed #ddc5a3; }
.reward-list { background: #fffdf8; border: 1rpx solid #e5d9c3; border-radius: 26rpx; padding: 0 22rpx; }
.reward-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx dashed #e4d6bf; }
.reward-row:last-child { border-bottom: 0; }
.reward-row > image { width: 96rpx; height: 96rpx; border-radius: 22rpx; border: 2rpx solid #f1e6d3; }
.reward-row .product-name { font-size: 26rpx; }
.reward-row .muted { font-size: 22rpx; margin-top: 5rpx; }
.reward-number { display: none; }
.rules-box { border-radius: 22rpx; padding: 24rpx; background: #f4eee1; margin: 24rpx 0; font-size: 23rpx; color: #786351; line-height: 1.8; }
.rules-box .product-name { color: #513e32; margin-bottom: 10rpx; font-size: 26rpx; }
.rules-box > text { display: block; }
.profile-row { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0 26rpx; }
.profile-row .page-title { font-size: 30rpx; margin: 0; }
.profile-row .muted { font-size: 22rpx; margin-top: 4rpx; }
.demo-pill { margin-left: auto; font-size: 19rpx; color: #786351; white-space: nowrap; }
.member-card { position: relative; border-radius: 32rpx; background: #e9ecd6; color: #4c5038; padding: 30rpx; border: 2rpx solid #cdd4ac; }
.member-card-top { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; font-size: 23rpx; font-weight: 650; }
.member-card-top > text:first-child, .member-title { display: block; }
.member-stats { display: flex; margin: 22rpx 0; }
.member-stats > view { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.member-stats > view + view { padding-left: 20rpx; }
.member-stats > view > text:last-child { font-size: 21rpx; color: #626449; margin-top: 8rpx; }
.stat-number { font-size: 40rpx; font-weight: 600; line-height: 1.3; white-space: nowrap; }
.level-track { width: 100%; height: 6rpx; background: #d1d7b6; border-radius: 4rpx; margin-bottom: 16rpx; overflow: hidden; }
.level-track > view { height: 100%; border-radius: 4rpx; background: #7f8c56; }
.wallet-breakdown, .member-progress { font-size: 21rpx; line-height: 1.7; color: #626449; }
.member-progress { margin-top: 5rpx; }
.recharge-entry { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; padding: 26rpx; border-radius: 26rpx; border: 1rpx solid #e7cf9b; background: #f7edca; margin: 20rpx 0 28rpx; }
.recharge-entry .product-name { font-size: 27rpx; }
.recharge-entry .muted { font-size: 21rpx; margin-top: 4rpx; }
.recharge-entry > text { font-size: 23rpx; white-space: nowrap; flex-shrink: 0; }
.account-links { padding: 0 24rpx; border: 1rpx solid #e6d8c2; border-radius: 26rpx; background: #fffdf8; }
.account-links > view { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 24rpx 0; border-bottom: 1rpx dashed #e7dac8; min-height: 100rpx; font-size: 26rpx; }
.account-links > view:last-child { border-bottom: 0; }
.account-links > view > text:first-child { flex-shrink: 0; }
.account-links > view > text:last-child { font-size: 22rpx; color: #786351; text-align: right; }
.gentle-note { margin-top: 22rpx; font-size: 23rpx; color: #786351; line-height: 1.8; white-space: pre-line; }
.demo-tools { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 18rpx; }
.demo-tools > button { padding: 16rpx 0; font-size: 23rpx; color: #786351; }
.order-filters { display: flex; border-bottom: 1rpx solid #e7e1d7; margin-bottom: 22rpx; }
.order-filters > view { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 88rpx; padding: 18rpx 4rpx; border-bottom: 3rpx solid transparent; font-size: 25rpx; color: #786351; }
.order-filters > view.active { color: #a25238; font-weight: 600; border-bottom-color: #a25238; }
.order-card { background: #fffdf8; border: 1rpx solid #e3d2b8; border-radius: 28rpx; padding: 28rpx; margin: 18rpx 0; }
.order-top { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; font-size: 25rpx; }
.order-status { font-size: 22rpx; color: #755235; background: #f4e6c1; border-radius: 20rpx; padding: 6rpx 16rpx; }
.order-code { font-size: 56rpx; font-weight: 650; text-align: center; padding: 22rpx 0 10rpx; white-space: nowrap; }
.order-code > text { display: block; font-size: 22rpx; font-weight: 400; color: #786351; margin-top: 6rpx; }
.order-number { font-size: 21rpx; color: #786351; margin-top: 18rpx; word-break: break-all; }
.pickup-date { background: #f4f1e9; border-radius: 8rpx; padding: 16rpx; text-align: center; margin: 18rpx 0; font-size: 25rpx; }
.order-item { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; font-size: 25rpx; margin: 12rpx 0; }
.order-total { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; border-top: 1rpx solid #e7e1d7; padding-top: 20rpx; margin-top: 20rpx; font-size: 27rpx; }
.order-total > text:last-child { font-size: 22rpx; color: #786351; text-align: right; }
.order-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.order-actions > button { flex: 1; width: 0; min-width: 0; font-size: 23rpx; padding: 18rpx 12rpx; }
.empty-state { padding: 45rpx 16rpx; text-align: center; }
.empty-state .muted { margin: 14rpx 0 24rpx; }
.admin-settings { border: 1rpx solid #e7e1d7; border-radius: 14rpx; padding: 24rpx; background: #fff; }
.admin-settings > input { width: 100%; margin-top: 16rpx; height: 80rpx; border: 1rpx solid #d9cec0; border-radius: 8rpx; padding: 12rpx 18rpx; }
.admin-products { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.admin-products > button { font-size: 22rpx; border: 1rpx solid #d9cec0; padding: 14rpx; min-height: 76rpx; }
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 60; display: flex; align-items: flex-end; background: #241c1859; }
.sheet { position: relative; width: 100%; max-height: 88vh; overflow-y: auto; border-radius: 36rpx 36rpx 0 0; background: #fffaf2; padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet-handle { height: 6rpx; width: 56rpx; border-radius: 3rpx; background: #d8cec0; margin: -12rpx auto 24rpx; }
.close-button { position: absolute; top: 10rpx; right: 12rpx; z-index: 2; width: 88rpx; height: 88rpx; min-width: 88rpx; min-height: 88rpx; padding: 0; background: #fffaf2; font-size: 40rpx; font-weight: 400; line-height: 1; }
.sheet .page-title { padding-right: 60rpx; font-size: 34rpx; }
.sheet-sub { font-size: 23rpx; color: #786351; margin: 8rpx 0 24rpx; }
.product-sheet-image { height: 400rpx; margin: -32rpx -32rpx 26rpx; background: #f7eee3; }
.product-sheet-image > image { height: 100%; width: 100%; object-fit: contain; }
.product-sheet-image ~ .sheet-handle { display: none; }
.detail-price { font-size: 40rpx; font-weight: 600; margin: 12rpx 0; }
.detail-price > text { font-size: 24rpx; font-weight: 400; color: #786351; margin-left: 8rpx; }
.detail-facts { border-top: 1rpx solid #e7e1d7; padding-top: 6rpx; }
.detail-facts > view { display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 0; font-size: 24rpx; }
.detail-facts > view > text:first-child { color: #786351; white-space: nowrap; }
.detail-facts > view > text:last-child { text-align: right; }
.detail-notice { font-size: 22rpx; color: #786351; line-height: 1.75; background: #f4eee1; padding: 18rpx; border-radius: 10rpx; margin: 16rpx 0; }
.checkout-item { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; }
.checkout-item > image { flex-shrink: 0; width: 90rpx; height: 90rpx; border-radius: 8rpx; object-fit: cover; }
.checkout-item > view:nth-child(2) { flex: 1; min-width: 0; }
.checkout-item .product-name { font-size: 25rpx; }
.checkout-item .muted { font-size: 22rpx; }
.form-grid { display: flex; gap: 16rpx; }
.form-grid > .form-field { flex: 1; min-width: 0; }
.form-field { margin: 18rpx 0; }
.form-field > text { display: block; font-size: 23rpx; color: #786351; margin-bottom: 10rpx; }
.form-field input, .picker-value { display: block; width: 100%; min-width: 0; height: 88rpx; padding: 18rpx; border-radius: 20rpx; background: #fffdf8; border: 1rpx solid #d9c6aa; font-size: 25rpx; line-height: 46rpx; }
.inline-warning { font-size: 23rpx; color: #804731; background: #f8e7df; padding: 18rpx; border-radius: 10rpx; }
.checkout-benefits { border-top: 1rpx solid #e7e1d7; margin-top: 22rpx; padding: 22rpx 0; }
.benefit-caption { font-size: 21rpx; color: #786351; margin-bottom: 16rpx; }
.benefit-line { display: flex; justify-content: space-between; gap: 18rpx; font-size: 25rpx; color: #735638; }
.coupon-option { width: 100%; display: flex; justify-content: space-between; align-items: center; min-height: 88rpx; border: 1rpx solid #d9cec0; border-radius: 10rpx; padding: 18rpx; font-size: 23rpx; text-align: left; background: #fff; margin-top: 14rpx; }
.coupon-option.chosen { background: #f3e7cb; border-color: #a78556; }
.payment-options { display: flex; gap: 16rpx; }
.payment-options > view { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 16rpx 8rpx; border: 1rpx solid #d9cec0; border-radius: 10rpx; font-size: 24rpx; background: #fff; }
.payment-options > view.selected { background: #f3e7cb; border-color: #a78556; }
.checkout-summary { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-top: 26rpx; }
.checkout-summary > view { flex: 1; min-width: 0; }
.checkout-summary .muted { font-size: 21rpx; }
.big-price { font-size: 40rpx; font-weight: 600; white-space: nowrap; margin-left: 8rpx; }
.checkout-summary > button { flex-shrink: 0; max-width: 60%; font-size: 24rpx; padding: 20rpx 22rpx; }
