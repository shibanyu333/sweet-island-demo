<view class="app {{count && (tab === 'home' || tab === 'menu') ? 'with-cart' : ''}}">
  <view class="topbar"><view class="wordmark" bindtap="nav" data-tab="home"><view class="mascot pose-0 brand-symbol"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view> 甜屿烘焙<text class="brand-en">SWEET ISLAND</text></view><text class="web-demo-badge">网页演示</text></view>
  <view wx:if="{{tab === 'home'}}" class="page home">
    <view class="product-poster {{poster.tone}}" bindtap="product" data-id="{{poster.id}}" role="button" aria-label="查看{{poster.name}}，{{poster.off?'今日售罄':'价格'+poster.priceText+'元'}}" hover-class="poster-pressed">
      <image class="poster-photo" src="/sweet-island-demo/images/{{poster.image}}.jpg" mode="aspectFill"/>
      <view class="poster-copy"><text class="poster-kicker">{{poster.kicker}}</text><view class="poster-title">{{poster.titleTop}}<view>{{poster.titleBottom}}</view></view><text class="poster-caption">{{poster.caption}}</text><view class="poster-price">¥{{poster.priceText}}<text>/ {{poster.spec}}</text></view><view class="poster-link">{{poster.off?'今日售罄 · 看看详情':'选这份甜 ↗'}}</view></view>
      <text class="poster-signature">甜屿 · 手作千层</text>
    </view>
    <view class="poster-toolbar"><view class="poster-tabs"><button wx:for="{{posters}}" wx:key="id" class="poster-tab {{posterIndex===index?'active':''}}" bindtap="posterTap" data-index="{{index}}" aria-label="切换到{{item.label}}海报" aria-pressed="{{posterIndex===index}}">{{item.label}}</button></view><text>0{{posterIndex+1}} / 02</text></view>
    <view class="home-store-note"><text class="green-dot"></text>10:00–20:00 · 手作千层专门店</view>
    <view class="service-entries">
      <view bindtap="modeTap" data-mode="pickup"><view class="mascot pose-1 "><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view>到店自提</view><text>把甜带走</text></view>
      <view bindtap="modeTap" data-mode="delivery"><view class="mascot pose-2 "><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view>外卖配送</view><text>甜蜜送到家</text></view>
      <view bindtap="modeTap" data-mode="dinein"><view class="mascot pose-3 "><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view>堂食点单</view><text>坐下吃口甜</text></view>
    </view>
    <view class="home-member-line"><view bindtap="nav" data-tab="mine"><text class="member-greeting">你好，{{memberName}}</text><text class="muted">{{tier.name}}会员 · 查看我的权益 ›</text></view><view bindtap="open" data-sheet="coupons"><text class="asset-number">{{couponCount}}</text><text>优惠券</text></view><view bindtap="nav" data-tab="stamps"><text class="asset-number">{{currentPoints}}</text><text>千层集点</text></view></view>
    <view class="home-offers"><view class="editorial-entry" bindtap="nav" data-tab="deals"><view><text class="entry-index">一起吃，才更甜</text><view>团购甜品</view><text>选好套餐 · 到店核销</text></view><view class="offer-bottom"><view class="mascot pose-1 "><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><text class="editorial-arrow">↗</text></view></view><view class="editorial-entry cream" bindtap="open" data-sheet="recharge"><view><text class="entry-index">给老朋友的小偏爱</text><view>充值有甜头</view><text>充 ¥100，赠 ¥10</text><text>再送 1 张毛巾卷券</text></view><view class="offer-bottom"><view class="gift-seal">赠<text>毛巾卷</text></view><text class="editorial-arrow">↗</text></view></view></view>
    <view wx:for="{{activePromotions}}" wx:key="kind" class="active-offer" bindtap="nav" data-tab="menu"><text>{{item.name}}</text><view>{{item.label}} ›</view></view><view class="season-heading"><text>今天，想吃哪一层？</text><view bindtap="nav" data-tab="menu">全部甜品 ›</view></view>
    <view class="product-grid"><view wx:for="{{featured}}" wx:key="id" class="product-card"><view class="product-image-wrap" bindtap="product" data-id="{{item.id}}"><image class="product-image" src="/sweet-island-demo/images/{{item.art}}.jpg" mode="aspectFill"/><text class="product-badge">{{item.tag}}</text></view><view class="product-body"><view class="product-name" bindtap="product" data-id="{{item.id}}">{{item.name}}</view><view class="home-product-spec">{{item.spec}} · {{item.flavor}}</view><view class="product-bottom"><text class="price"><text class="currency">¥</text>{{item.priceText}}</text><view class="add-button" bindtap="add" data-id="{{item.id}}" aria-label="添加{{item.name}}" role="button"><view class="quantity-disc"><view class="quantity-line"></view><view class="quantity-line quantity-line-vertical"></view></view></view></view></view></view></view>
    <view class="home-footer">甜，是认真生活的小奖励。<text>SWEET ISLAND BAKERY</text></view>
  </view>
  <view wx:elif="{{tab === 'menu'}}" class="page menu-page">
    <view class="menu-store"><view><view class="card-title">甜屿烘焙 · 小岛店</view><text class="muted">手作千层 · 每日新鲜</text></view><view class="mode-switch"><view bindtap="modeTap" data-mode="pickup" class="{{mode==='pickup'?'active':''}}">自提</view><view bindtap="modeTap" data-mode="dinein" class="{{mode==='dinein'?'active':''}}">堂食</view><view bindtap="modeTap" data-mode="delivery" class="{{mode==='delivery'?'active':''}}">外卖</view></view></view>
    <view class="search-field"><text>⌕</text><input placeholder="搜索甜品、口味或配料" value="{{search}}" bindinput="input" data-field="search"/></view>
    <view class="menu-layout"><view class="menu-categories"><view wx:for="{{categories}}" wx:key="*this" class="{{category === item ? 'selected' : ''}}" bindtap="categoryTap" data-category="{{item}}">{{item}}</view></view><view class="menu-catalog"><view class="catalog-heading"><text>{{category==='全部'?'全部甜品':category}}</text><text>{{visibleProducts.length}} 款</text></view><view class="menu-note">指定千层每份集 1 点，5 / 8 / 10 点有礼</view><view wx:if="{{!visibleProducts.length}}" class="empty-state"><view class="card-title">没找到这份甜</view><view class="muted">换个口味关键词，或看看全部甜品。</view><button class="outline-button" bindtap="clearSearch">查看全部甜品</button></view><view class="catalog-grid"><view wx:for="{{visibleProducts}}" wx:key="id" class="catalog-product"><view class="catalog-photo" bindtap="product" data-id="{{item.id}}"><image src="/sweet-island-demo/images/{{item.art}}.jpg" mode="aspectFill"/><text wx:if="{{item.off}}" class="sold-out-label">今日售罄</text><text wx:if="{{item.qty}}" class="selected-qty">已选 {{item.qty}}</text></view><view class="product-name" bindtap="product" data-id="{{item.id}}">{{item.name}}</view><text class="catalog-description">{{item.spec}} · {{item.point?'可集点':item.cat==='整只蛋糕'?'提前 1 天':item.flavor}}</text><view class="product-bottom"><text class="price">¥{{item.priceText}}</text><view wx:if="{{!item.off}}" class="add-button" bindtap="add" data-id="{{item.id}}" aria-label="添加{{item.name}}" role="button"><view class="quantity-disc"><view class="quantity-line"></view><view class="quantity-line quantity-line-vertical"></view></view></view><text wx:else class="muted">售罄</text></view></view></view><view class="footnote">整只蛋糕提前 1 天，其余甜品至少提前 2 小时。</view></view></view>
  </view>
  <view wx:elif="{{tab === 'deals'}}" class="page"><view class="page-heading"><view class="page-title">到店团购</view><view class="muted">小程序自售套餐 · 购买后到店核销</view></view><view wx:if="{{!deals.length}}" class="empty-state"><view class="mascot pose-3 empty-mascot"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view class="card-title">套餐正在准备中</view><view class="muted">门店发布套餐后，即可在这里购买。</view><button class="outline-button" bindtap="nav" data-tab="menu">先逛逛甜品</button></view><view wx:for="{{deals}}" wx:key="id" class="deal-card" bindtap="viewDeal" data-id="{{item.id}}"><image src="/sweet-island-demo/images/{{item.art}}.jpg" mode="aspectFill"/><view><view class="card-title">{{item.name}}</view><view class="muted" wx:for="{{item.items}}" wx:for-item="good" wx:key="id">{{good.name}} × {{good.qty}}</view><view class="muted">购买后 {{item.days}} 天内到店核销</view><view class="deal-price">¥{{item.priceText}} <text>{{item.sold>=item.stock?'已售罄':'查看套餐 ›'}}</text></view></view></view></view>
  <view wx:elif="{{tab === 'stamps'}}" class="page"><view class="page-heading"><text class="eyebrow">COLLECT SWEET MOMENTS</text><view class="page-title">甜蜜集点</view><view class="muted">攒下每一口喜欢，兑换下一份甜。</view></view><view class="stamp-card"><view class="stamp-ticket-label">SWEET LITTLE REWARDS</view><view class="stamp-card-head"><view><text class="eyebrow">SWEET CLUB</text><view class="card-title">我的甜蜜集点卡</view></view><view class="point-count">{{currentPoints}}<text>/ 10</text></view></view><view class="stamps"><view wx:for="{{stamps}}" wx:key="n" class="stamp-cell"><view class="stamp {{item.active ? 'filled' : ''}} {{item.reward ? 'reward' : ''}}"><view wx:if="{{item.active}}" class="mascot pose-0 stamp-mascot"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><text wx:else>{{item.n}}</text></view><text>{{item.label}}</text></view></view><view class="stamp-card-foot">把喜欢盖成章，下一份甜慢慢攒。</view></view><view class="section-title">集点奖励</view><view class="reward-list"><view class="reward-row"><image src="/sweet-island-demo/images/roll.jpg" mode="aspectFill"/><view><view class="product-name">5 点 · 芒果毛巾卷</view><view class="muted">软乎乎的第一份奖励</view></view><text class="reward-number">05</text></view><view class="reward-row"><image src="/sweet-island-demo/images/bowl.jpg" mode="aspectFill"/><view><view class="product-name">8 点 · 草莓饱饱碗</view><view class="muted">快乐装得满满当当</view></view><text class="reward-number">08</text></view><view class="reward-row"><image src="/sweet-island-demo/images/mango.jpg" mode="aspectFill"/><view><view class="product-name">10 点 · 招牌芒果千层</view><view class="muted">甜蜜一整轮，奖励一整份</view></view><text class="reward-number">10</text></view></view><view class="rules-box"><view class="product-name">集点小约定</view><text>每购买 1 份活动切块千层集 1 点，取货后到账。5 / 8 / 10 点奖励可依次领取，不扣点；满 10 点开启下一轮，多余点数继续累计。奖励券 90 天内有效。赠品、兑换商品及生日半价商品不集点。</text></view><button size="mini" class="brown-button wide" bindtap="nav" data-tab="menu">去挑一份千层 ↗</button></view>
  <view wx:elif="{{tab === 'mine'}}" class="page"><view class="profile-row"><view class="mascot pose-0 avatar"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view><view class="page-title">你好，{{memberName}}</view><view class="muted">查看余额、优惠券和集点</view></view><text class="demo-pill">演示账号</text></view><view class="member-card"><view class="member-card-top"><text>甜屿 · 甜蜜会员卡</text><text>{{tier.name}}会员</text></view><view class="member-title">把每一口喜欢，存起来。</view><view class="member-stats"><view><text class="stat-number numeric">{{balanceText}}</text><text>账户余额（元）</text></view><view bindtap="open" data-sheet="coupons"><text class="stat-number numeric">{{couponCount}}</text><text>我的甜蜜券 ↗</text></view><view bindtap="nav" data-tab="stamps"><text class="stat-number numeric">{{currentPoints}}</text><text>本轮集点 ↗</text></view></view><view class="level-track"><view style="{{levelTrackStyle}}"></view></view><view class="wallet-breakdown">充值本金 ¥{{principalText}} · 赠送余额 ¥{{bonusText}}</view><view class="member-progress">{{!rulesConfigured?'等级门槛与折扣待门店设置':tier.name === '黑卡' ? '已是最高等级' : '再消费 ¥' + nextSpend + '，升级' + nextTier}}</view></view><view class="recharge-entry" bindtap="open" data-sheet="recharge"><view><view class="product-name">充值有礼</view><view class="muted">充值赠余额，再送芒果毛巾卷券</view></view><text>立即充值 ↗</text></view><view class="section-title">会员服务</view><view class="account-links"><view bindtap="nav" data-tab="orders"><text>我的订单</text><text>查看取货码 ↗</text></view><view bindtap="open" data-sheet="birthday"><text>生日专属礼遇</text><text>{{birthday ? birthdayMonth + ' · 已设置' : '生日当天千层半价'}} ↗</text></view><view bindtap="open" data-sheet="levels"><text>会员等级权益</text><text>{{tier.name}}会员 ↗</text></view><view bindtap="open" data-sheet="ledger"><text>余额收支明细</text><text>查看记录 ↗</text></view></view><view class="gentle-note">生日当天，千层蛋糕半价。
{{birthdayPolicy ? (birthdayPolicy==='one'?'当前配置：一份活动切块千层，每年一次。':'当前配置：当单活动切块千层，每年一次。') : '适用商品与数量范围待门店设置。'}}</view><view class="account-links extra-links"><view bindtap="nav" data-tab="deals"><text>我的团购好礼</text><text>查看套餐 ›</text></view><view bindtap="nav" data-tab="stamps"><text>千层集点卡</text><text>5 / 8 / 10 点有礼 ›</text></view></view><view class="demo-tools"><button size="mini" bindtap="resetWebDemo">重置本机演示</button><button size="mini" bindtap="replaySplash">重看品牌开场</button><button size="mini" bindtap="enterAdmin">商家演示 ↗</button></view><view class="footnote">本版本为本地演示，充值和支付均不产生真实扣款。</view></view>
  <view wx:elif="{{tab === 'orders' || tab === 'admin'}}" class="page"><view class="page-heading"><text class="eyebrow">{{tab === 'admin' ? 'MERCHANT DEMO' : 'YOUR SWEET RESERVATIONS'}}</text><view class="page-title">{{tab === 'admin' ? '商家工作台' : '我的订单'}}</view><view class="muted">{{tab === 'admin' ? '本地演示 · 订单、核销、会员与营销管理' : '自提、堂食、外卖与团购订单，都在这里。'}}</view></view><view wx:if="{{tab==='admin' && admin}}"><view class="admin-nav"><view bindtap="adminTab" data-section="orders" class="{{adminSection==='orders'?'active':''}}">订单</view><view bindtap="adminTab" data-section="verify" class="{{adminSection==='verify'?'active':''}}">核销</view><view bindtap="adminTab" data-section="members" class="{{adminSection==='members'?'active':''}}">会员</view><view bindtap="adminTab" data-section="coupons" class="{{adminSection==='coupons'?'active':''}}">发券</view><view bindtap="adminTab" data-section="deals" class="{{adminSection==='deals'?'active':''}}">团购</view><view bindtap="adminTab" data-section="settings" class="{{adminSection==='settings'?'active':''}}">活动设置</view></view>
<view wx:if="{{adminSection==='orders'}}" class="admin-settings"><view class="product-name">每半小时时段容量</view><input type="number" value="{{settings.capacity}}" bindchange="capacityChange"/><view class="admin-products"><button wx:for="{{products}}" wx:key="id" bindtap="toggle" data-id="{{item.id}}">{{item.name}} · {{item.off?'售罄':'在售'}} ↻</button></view></view>
<view wx:elif="{{adminSection==='verify'}}" class="admin-panel"><view class="card-title">团购 / 订单核销</view><view class="form-field"><text>输入顾客出示的六位码</text><input type="number" value="{{codeInput}}" bindinput="input" data-field="codeInput" placeholder="六位核销码"/></view><button class="brown-button wide" bindtap="findCode">查询核销码</button><view wx:if="{{codeOrder}}" class="rules-box"><view class="card-title">{{codeOrder.modeText}} · {{codeOrder.statusText}}</view><view>会员：{{codeOrder.memberName}}</view><view>核销码：{{codeOrder.code}}</view><view wx:for="{{codeOrder.items}}" wx:key="id">{{item.name}} × {{item.qty}}</view><view>{{codeOrder.fulfilmentText}}</view><button wx:if="{{codeOrder.status==='paid'}}" class="brown-button wide" bindtap="confirmCode">确认商品已交付，完成核销</button></view></view>
<view wx:elif="{{adminSection==='members'}}" class="admin-panel"><view class="card-title">会员录入</view><view class="form-field"><text>会员姓名</text><input type="text" value="{{newMemberName}}" bindinput="input" data-field="newMemberName" placeholder="填写姓名"/></view><view class="form-field"><text>手机号</text><input type="number" value="{{newMemberPhone}}" bindinput="input" data-field="newMemberPhone" placeholder="本地演示请使用测试号码"/></view><button class="brown-button wide" bindtap="enrollMember">录入会员</button><view class="form-field"><text>查找会员</text><input type="text" value="{{memberSearch}}" bindinput="input" data-field="memberSearch" placeholder="姓名或手机号"/></view><view wx:for="{{memberResults}}" wx:key="id" class="member-list-row"><view><view>{{item.name}}{{item.active?' · 当前':''}}</view><text class="muted">{{item.phone||'默认演示账号'}} · 余额 ¥{{item.balanceText}} · {{item.couponCount}} 张券</text></view><button class="outline-button" bindtap="simulateMember" data-id="{{item.id}}">模拟此会员</button></view><view class="footnote">仅切换本机演示资料，不是正式账号登录。</view></view>
<view wx:elif="{{adminSection==='coupons'}}" class="admin-panel"><view class="card-title">不定时发券 / 指定会员发券</view><view class="form-field"><text>优惠券名称</text><input type="text" value="{{couponTitle}}" bindinput="input" data-field="couponTitle" placeholder="例如：周末甜品礼"/></view><view class="form-field"><text>减免金额（元）</text><input type="digit" value="{{couponAmount}}" bindinput="input" data-field="couponAmount" placeholder="商家设置金额"/></view><view class="form-field"><text>使用门槛（元，0 为无门槛）</text><input type="digit" value="{{couponMinimum}}" bindinput="input" data-field="couponMinimum" placeholder="商家设置门槛"/></view><view class="form-field"><text>有效天数</text><input type="number" value="{{couponDays}}" bindinput="input" data-field="couponDays" placeholder="1–365"/></view><view class="product-name">发放对象</view><view class="admin-chips"><button bindtap="targetMember" data-id="all" class="{{couponTarget==='all'?'chosen':''}}">全部已录入会员</button><button wx:for="{{members}}" wx:key="id" bindtap="targetMember" data-id="{{item.id}}" class="{{couponTarget===item.id?'chosen':''}}">{{item.name}}</button></view><button class="brown-button wide" bindtap="sendCoupons">立即发放到所选演示账户</button><view class="section-title">发放记录</view><view wx:for="{{campaigns}}" wx:key="id" class="ledger-row"><view>{{item.title}}<text class="muted">{{item.date}} · {{item.targetText}}</text></view><text>{{item.count}} 张</text></view></view>
<view wx:elif="{{adminSection==='deals'}}" class="admin-panel"><view class="card-title">发布自售团购套餐</view><view class="form-field"><text>套餐名称</text><input type="text" value="{{dealName}}" bindinput="input" data-field="dealName" placeholder="例如：双人下午茶"/></view><view class="form-field"><text>套餐价格（元）</text><input type="digit" value="{{dealPrice}}" bindinput="input" data-field="dealPrice" placeholder="客户未定价，请填写演示价格"/></view><view class="form-field"><text>可售份数</text><input type="number" value="{{dealStock}}" bindinput="input" data-field="dealStock" placeholder="库存"/></view><view class="form-field"><text>购买后有效天数</text><input type="number" value="{{dealDays}}" bindinput="input" data-field="dealDays" placeholder="有效天数"/></view><view class="form-field"><text>套餐商品一</text><picker range="{{productNames}}" value="{{dealFirstIndex}}" bindchange="dealProductChange" data-field="dealFirst"><view class="picker-value">{{productNames[dealFirstIndex]}}</view></picker></view><view class="form-field"><text>商品一数量</text><input type="number" value="{{dealFirstQty}}" bindinput="input" data-field="dealFirstQty" placeholder="份数"/></view><view class="form-field"><text>套餐商品二</text><picker range="{{productNames}}" value="{{dealSecondIndex}}" bindchange="dealProductChange" data-field="dealSecond"><view class="picker-value">{{productNames[dealSecondIndex]}}</view></picker></view><view class="form-field"><text>商品二数量</text><input type="number" value="{{dealSecondQty}}" bindinput="input" data-field="dealSecondQty" placeholder="份数"/></view><button class="brown-button wide" bindtap="publishDeal">上架演示套餐</button><view class="rules-box">当前团购不参与集点、不叠加券或活动，具体规则待门店确认。未接第三方平台。</view><view class="ledger-row" wx:for="{{deals}}" wx:key="id"><view>{{item.name}}<text class="muted">已售 {{item.sold}} / {{item.stock}}</text></view><text>¥{{item.priceText}}</text></view></view>
<view wx:elif="{{adminSection==='settings'}}" class="admin-panel"><view class="card-title">满减 / 新人优惠</view><view class="admin-chips"><button bindtap="activityKind" data-kind="fullReduction" class="{{marketingKind==='fullReduction'?'chosen':''}}">满减活动</button><button bindtap="activityKind" data-kind="newcomer" class="{{marketingKind==='newcomer'?'chosen':''}}">新人首单</button></view><view class="form-field"><text>订单门槛（元）</text><input type="digit" value="{{activityMinimum}}" bindinput="input" data-field="activityMinimum" placeholder="待商家配置"/></view><view class="form-field"><text>减免金额（元）</text><input type="digit" value="{{activityAmount}}" bindinput="input" data-field="activityAmount" placeholder="待商家配置"/></view><button class="brown-button wide" bindtap="saveActivity">保存并启用演示活动</button><view wx:for="{{activePromotions}}" wx:key="kind" class="ledger-row"><view>{{item.name}}<text class="muted">{{item.label}}</text></view><button class="outline-button" bindtap="disableActivity" data-kind="{{item.kind}}">关闭</button></view><view class="rules-box">演示以首次有效订单判定新人；优惠择优不叠加，规则待门店确认。</view><view class="section-title">会员与生日</view><button class="outline-button wide" bindtap="editTiers">设置五级门槛与折扣</button><view class="muted">生日当天千层半价，选择演示适用范围：</view><view class="admin-chips"><button bindtap="setBirthdayPolicy" data-policy="one" class="{{birthdayPolicy==='one'?'chosen':''}}">一份活动切块</button><button bindtap="setBirthdayPolicy" data-policy="all" class="{{birthdayPolicy==='all'?'chosen':''}}">当单全部活动切块</button><button bindtap="setBirthdayPolicy" data-policy="pending">保持待设置</button></view><view class="footnote">目前仅配置活动切块千层，整只千层及次数限制需确认。</view><view class="section-title">外卖配送规则</view><view class="form-field"><text>配送范围</text><input type="text" value="{{deliveryAreaInput}}" bindinput="input" data-field="deliveryAreaInput" placeholder="例如：门店周边3公里，演示人工核对"/></view><view class="form-field"><text>起送金额（元）</text><input type="digit" value="{{deliveryMinimumInput}}" bindinput="input" data-field="deliveryMinimumInput" placeholder="0 表示无起送门槛"/></view><view class="form-field"><text>配送费（元）</text><input type="digit" value="{{deliveryFeeInput}}" bindinput="input" data-field="deliveryFeeInput" placeholder="0 表示免配送费"/></view><button class="brown-button wide" bindtap="saveDelivery">保存配送规则</button><view wx:if="{{settings.delivery}}" class="rules-box">已设置范围：{{settings.delivery.area}} · 配送费 ¥{{deliveryFeeText}}</view></view></view><view wx:if="{{tab!=='admin'||adminSection==='orders'}}" class="order-filters"><view wx:for="{{orderFilters}}" wx:key="id" class="{{orderFilter === item.id ? 'active' : ''}}" bindtap="filterOrder" data-filter="{{item.id}}" role="button" hover-class="control-pressed">{{item.label}}</view></view><view wx:if="{{!displayOrders.length && (tab!=='admin'||adminSection==='orders')}}" class="empty-state"><view class="mascot pose-1 empty-mascot"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view><view class="card-title">{{orderFilter === 'all' ? '还没有预约订单' : '暂无这类订单'}}</view><view class="muted">去挑一份喜欢的，给今天加点甜。</view><button size="mini" class="brown-button" bindtap="nav" data-tab="menu">去逛逛 ↗</button></view><block wx:if="{{tab!=='admin'||adminSection==='orders'}}"><view wx:for="{{displayOrders}}" wx:key="id" class="order-card"><view class="order-top"><text>{{item.modeText}}<text wx:if="{{tab==='admin'}}"> · {{item.memberName}}</text></text><text class="order-status">{{item.statusText}}</text></view><view wx:if="{{item.status === 'paid' && item.mode!=='delivery'}}" class="order-code">{{item.code}}<text>{{item.kind==='deal'?'到店出示核销码':item.mode==='dinein'?'堂食订单码':'到店出示取货码'}}</text></view><view wx:else class="order-number">订单编号：{{item.id}}</view><view class="pickup-date">{{item.fulfilmentText}}</view><view wx:if="{{item.table}}" class="muted">桌号：{{item.table}}</view><view wx:if="{{item.address}}" class="muted">配送至：{{item.receiver}} · {{item.address}}</view><view wx:for="{{item.items}}" wx:for-item="good" wx:key="id" class="order-item"><text>{{good.name}}</text><text>× {{good.qty}}</text></view><view wx:if="{{item.note}}" class="muted">备注：{{item.note}}</view><view class="order-total"><text>合计 ¥{{item.totalText}}</text><text>{{item.pointHint}}</text></view><view wx:if="{{tab === 'admin' && admin && item.status === 'paid'}}" class="order-actions"><button size="mini" class="outline-button" bindtap="cancel" data-id="{{item.id}}">取消并退回权益</button><button size="mini" class="brown-button" bindtap="complete" data-id="{{item.id}}">确认完成</button></view></view></block></view>
  <view wx:if="{{count > 0 && (tab === 'home' || tab === 'menu')}}" class="cart-bar"><view><text class="bag-count">{{count}}</text><text class="cart-price">¥{{cartTotal}}</text><text class="cart-note">{{modeText}}</text></view><button size="mini" bindtap="open" data-sheet="checkout">查看购物袋 ↗</button></view>
  <view class="tabbar"><view class="tab {{tab === 'home' ? 'active' : ''}}" bindtap="nav" data-tab="home"><view class="nav-icon"><image src="/sweet-island-demo/images/nav-home.png"/></view><text>首页</text></view><view class="tab {{tab === 'menu' ? 'active' : ''}}" bindtap="nav" data-tab="menu"><view class="nav-icon"><image src="/sweet-island-demo/images/nav-cake.png"/></view><text>点单</text></view><view class="tab {{tab === 'orders' ? 'active' : ''}}" bindtap="nav" data-tab="orders"><view class="nav-icon"><image src="/sweet-island-demo/images/nav-order.png"/></view><text>订单{{paidCount ? ' · ' + paidCount : ''}}</text></view><view class="tab {{tab === 'mine' ? 'active' : ''}}" bindtap="nav" data-tab="mine"><view class="nav-icon mascot-nav"><view class="mascot pose-0 "><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view></view><text>我的</text></view></view>
  <view wx:if="{{sheet}}" class="overlay" bindtap="close"><view class="sheet {{sheet==='coupons'||sheet==='couponRules'?'full-sheet':''}}" catchtap="noop"><view wx:if="{{sheet === 'product'}}" class="product-sheet-image"><image wx:if="{{detail.art}}" src="/sweet-island-demo/images/{{detail.art}}.jpg" mode="aspectFit"/></view><view class="sheet-handle"></view><button size="mini" class="close-button" bindtap="close" aria-label="关闭弹窗">×</button>
    <block wx:if="{{sheet === 'product'}}"><text class="detail-example-label">演示商品 · 以门店实际配方为准</text><view class="page-title">{{detail.name}}</view><view class="detail-price">¥{{detail.priceText}}<text>/ {{detail.spec}}</text></view><view class="detail-tags"><text>{{detail.flavor}}</text><text>{{detail.serving}}</text><text>{{detail.point?'指定集点商品':'不参与集点'}}</text></view><view class="sheet-sub">{{detail.sub}}</view><view class="detail-description">{{detail.tasting}}</view>
<view class="detail-facts"><view><text>商品规格</text><text>{{detail.spec}} · {{detail.weight}}（示例）</text></view><view><text>下单方式</text><text>自提 / 堂食 / 外卖，以门店设置为准</text></view><view><text>预约制作</text><text>{{detail.leadText}}</text></view><view><text>集点规则</text><text>{{detail.pointText}}</text></view></view>
<view class="detail-section"><view class="card-title">这一份甜，用了什么</view><text class="detail-section-label">示例配料</text><view>{{detail.ingredients}}</view><view class="allergen-note"><text>过敏原提示</text><view>{{detail.allergens}}</view><view>{{detail.crossContact}}</view></view></view>
<view class="detail-section"><view class="card-title">好好保存，慢慢享用</view><view>{{detail.storage}}</view><view>{{detail.bestBefore}}</view><view wx:if="{{detail.cat==='整只蛋糕'}}">整只蛋糕请提前 1 天预约；餐具与祝福需求可在订单备注填写。</view></view>
<view class="detail-notice">本页图片、价格、重量、配料与保存说明均为演示示例，正式经营前由门店核实并替换，实际以商品标签为准。</view><view class="product-action"><button class="outline-button product-return" bindtap="close">继续选甜品</button><button size="mini" wx:if="{{!detail.off}}" class="brown-button wide" bindtap="addDetail">加入购物袋 · ¥{{detail.priceText}}</button><button size="mini" wx:else disabled class="brown-button wide disabled-button">今日售罄</button></view></block>
    <block wx:elif="{{sheet === 'checkout'}}"><text class="eyebrow">SAVE A SWEET MOMENT</text><view class="page-title">确认预约</view><view class="sheet-sub">甜屿烘焙 · 小岛店 · {{modeText}}</view><view class="checkout-items"><view wx:for="{{cart}}" wx:key="id" class="checkout-item"><image src="/sweet-island-demo/images/{{item.art}}.jpg"/><view><view class="product-name">{{item.name}}</view><view class="muted">¥{{item.priceText}} / {{item.spec}}</view></view><view class="quantity"><view class="minus-button" bindtap="minus" data-id="{{item.id}}" aria-label="减少数量" role="button" hover-class="control-pressed"><view class="quantity-disc"><view class="quantity-line"></view></view></view><text class="quantity-value">{{item.qty}}</text><view class="add-button" bindtap="add" data-id="{{item.id}}" aria-label="增加数量" role="button" hover-class="control-pressed"><view class="quantity-disc"><view class="quantity-line"></view><view class="quantity-line quantity-line-vertical"></view></view></view></view></view></view><view class="mode-switch checkout-modes"><view bindtap="checkoutMode" data-mode="pickup" class="{{mode==='pickup'?'active':''}}">自提</view><view bindtap="checkoutMode" data-mode="dinein" class="{{mode==='dinein'?'active':''}}">堂食</view><view bindtap="checkoutMode" data-mode="delivery" class="{{mode==='delivery'?'active':''}}">外卖</view></view><view wx:if="{{mode==='dinein'}}" class="form-field"><text>堂食桌号</text><input value="{{table}}" bindinput="input" data-field="table" placeholder="请输入桌号" maxlength="12"/></view><view wx:if="{{mode==='delivery'}}"><view class="inline-warning" wx:if="{{!settings.delivery}}">门店尚未设置配送范围、起送金额与配送费，暂不能下单。</view><view wx:else class="rules-box">配送范围：{{settings.delivery.area}} · 配送费 ¥{{deliveryFeeText}}<view>当前为演示地址校验，配送范围需商家人工核对。</view></view><view class="form-field"><text>收货人</text><input value="{{receiver}}" bindinput="input" data-field="receiver" placeholder="收货人姓名" maxlength="24"/></view><view class="form-field"><text>配送地址</text><input value="{{address}}" bindinput="input" data-field="address" placeholder="街道、门牌号及楼层" maxlength="120"/></view></view><view wx:if="{{mode!=='dinein'}}" class="form-grid"><view class="form-field"><text>{{mode==='delivery'?'配送日期':'到店日期'}}</text><picker mode="selector" range="{{dates}}" value="{{dateIndex}}" bindchange="dateChange"><view class="picker-value">{{date}} ⌄</view></picker></view><view class="form-field"><text>{{mode==='delivery'?'配送时间':'到店时间'}}</text><picker mode="selector" range="{{times}}" value="{{timeIndex}}" bindchange="timeChange"><view class="picker-value">{{time || '请更换日期'}} ⌄</view></picker></view></view><view wx:if="{{!times.length && mode!=='dinein'}}" class="inline-warning">当天无法预约：请检查提前制作时间，或更换取货日期。</view><view class="form-field"><text>联系手机</text><input type="number" maxlength="11" placeholder="填写取货联系手机号" value="{{phone}}" bindinput="input" data-field="phone"/></view><view class="form-field"><text>给店主的话（选填）</text><input maxlength="100" placeholder="例如：请帮我准备一把小叉子" value="{{note}}" bindinput="input" data-field="note"/></view><view class="checkout-benefits"><view class="benefit-caption">优惠不叠加 · 系统比较后使用更划算的一项</view><view class="benefit-line"><text>{{quoteLabel}}</text><text>− ¥{{quoteSaving}}</text></view><button size="mini" wx:if="{{birthdayAvailable}}" class="coupon-option {{useBirthday ? 'chosen' : ''}}" bindtap="birthdayTap">{{birthdayPolicy==='all'?'当单活动千层半价':'一份活动千层半价'}} {{useBirthday ? '✓' : '选择'}} · 生日当天取货</button><button size="mini" wx:for="{{validCoupons}}" wx:key="id" class="coupon-option {{selectedCoupon === item.id ? 'chosen' : ''}}" bindtap="couponTap" data-id="{{item.id}}">{{item.name}} {{item.kind==='cash'?item.minimumText:'兑换券'}} {{selectedCoupon === item.id ? '✓' : '使用'}}</button></view><view wx:if="{{!quoteFree}}" class="payment-options"><view class="{{payment === 'wechat' ? 'selected' : ''}}" bindtap="paymentTap" data-payment="wechat" role="button" hover-class="control-pressed">演示微信支付</view><view class="{{payment === 'balance' ? 'selected' : ''}}" bindtap="paymentTap" data-payment="balance" role="button" hover-class="control-pressed">余额 ¥{{balanceText}}</view></view><view wx:if="{{mode==='delivery' && settings.delivery}}" class="benefit-line"><text>配送费</text><text>¥{{deliveryFeeText}}</text></view><view class="checkout-summary"><view><text class="muted">合计</text><text class="big-price numeric">¥{{quoteTotal}}</text><view class="muted">取货后可集 {{quotePoints}} 点</view></view><button size="mini" class="brown-button {{(mode!=='dinein'&&!times.length)||(mode==='delivery'&&!settings.delivery)?'disabled-button':''}}" disabled="{{(mode!=='dinein'&&!times.length)||(mode==='delivery'&&!settings.delivery)}}" bindtap="submit">{{quoteFree ? '确认预约 · 免费兑换' : '确认预约 · 演示支付'}}</button></view><view class="footnote">此为本地演示，不会产生真实扣款。</view></block>
    <block wx:elif="{{sheet === 'recharge'}}"><text class="eyebrow">MORE SWEETNESS FOR YOU</text><view class="page-title">会员充值</view><view class="sheet-sub">赠余额，再送芒果毛巾卷兑换券</view><view class="recharge-options"><view wx:for="{{rechargeOptions}}" wx:key="amount" class="recharge-option {{selectedRecharge === item.amount ? 'selected' : ''}}" bindtap="rechargeSelect" data-amount="{{item.amount}}"><view class="recharge-amount numeric">¥{{item.amount}}</view><view>到账 ¥{{item.total}}</view><text>送 {{item.count}} 张毛巾卷券</text></view></view><view class="rules-box">兑换券有效期 90 天，每张兑换一个毛巾卷。本金与赠送余额分别记账，充值不计入会员消费。</view><button size="mini" class="brown-button wide" bindtap="recharge">确认演示充值 ¥{{selectedRecharge}}</button><view class="footnote">仅模拟充值，不会调用真实支付。</view></block>
    <block wx:elif="{{sheet === 'coupons'}}"><view class="page-title">我的优惠券</view><view class="coupon-tabs"><view bindtap="couponFilterTap" data-filter="valid" class="{{couponFilter==='valid'?'active':''}}">可使用</view><view bindtap="couponFilterTap" data-filter="invalid" class="{{couponFilter==='invalid'?'active':''}}">已使用 / 已过期</view></view><view wx:if="{{!displayCoupons.length}}" class="empty-state"><view class="card-title">{{couponFilter==='valid'?'暂时没有可用券':'暂无失效券'}}</view><view class="muted">充值赠礼、千层集点奖励与门店发券都会收进这里。</view></view><view wx:for="{{displayCoupons}}" wx:key="id" class="ticket {{!item.valid?'ticket-invalid':''}}"><view class="ticket-main"><view class="ticket-value">{{item.face}}<text>{{item.minimumText}}</text></view><view class="ticket-info"><view>{{item.name}}</view><text>{{item.source}}</text><text>{{item.date}} 前有效</text></view></view><view class="ticket-bottom"><view bindtap="couponRules" data-id="{{item.id}}">使用规则 ›</view><button wx:if="{{item.valid}}" bindtap="redeem" data-id="{{item.id}}" data-product="{{item.product}}">去使用</button><text wx:else>{{item.used?'已使用':'已过期'}}</text></view></view></block>
    <block wx:elif="{{sheet==='couponRules'}}"><view class="page-title">优惠券使用规则</view><view class="rules-box"><view class="card-title">{{couponDetail.name}}</view><view>{{couponDetail.minimumText}}</view><view>适用商品：{{couponDetail.scopeText}}</view><view>有效期至：{{couponDetail.date}}</view><view>来源：{{couponDetail.source}}</view><view>当前演示采用优惠择优、不叠加；正式叠加规则待客户确认。</view></view><button class="brown-button wide" bindtap="open" data-sheet="coupons">返回我的优惠券</button></block>
    <block wx:elif="{{sheet==='deal'}}"><image class="deal-cover" src="/sweet-island-demo/images/{{selectedDeal.art}}.jpg" mode="aspectFill"/><view class="page-title">{{selectedDeal.name}}</view><view wx:for="{{selectedDeal.items}}" wx:key="id" class="order-item"><text>{{item.name}}</text><text>× {{item.qty}}</text></view><view class="rules-box">购买后 {{selectedDeal.days}} 天有效。到店提供六位券码，商家核销后领取。套餐暂不参与千层集点；此项规则待门店确认。</view><view class="payment-options"><view bindtap="paymentTap" data-payment="wechat" class="{{payment==='wechat'?'selected':''}}">演示微信支付</view><view bindtap="paymentTap" data-payment="balance" class="{{payment==='balance'?'selected':''}}">余额 ¥{{balanceText}}</view></view><button class="brown-button wide" disabled="{{selectedDeal.sold>=selectedDeal.stock}}" bindtap="purchaseDeal">{{selectedDeal.sold>=selectedDeal.stock?'已售罄':'演示购买 · ¥'+selectedDeal.priceText}}</button><view class="footnote">本地演示，不会产生真实扣款。</view></block>
    <block wx:elif="{{sheet==='tierEditor' && admin}}"><view class="page-title">设置五级会员</view><view class="rules-box">客户仅确认等级名称。请按实际规则填写累计消费门槛和折扣比例，100 表示不打折、95 表示 9.5 折。</view><view wx:for="{{tierInputs}}" wx:key="name" class="tier-editor-row"><text>{{item.name}}</text><input type="number" placeholder="门槛（元）" value="{{item.threshold}}" bindinput="tierInput" data-index="{{index}}" data-key="threshold"/><input type="number" placeholder="折扣比例" value="{{item.rate}}" bindinput="tierInput" data-index="{{index}}" data-key="rate"/></view><button class="brown-button wide" bindtap="saveTiers">保存演示规则</button></block>
    <block wx:elif="{{sheet === 'birthday'}}"><text class="eyebrow">HAPPY BIRTHDAY TO YOU</text><view class="page-title">设置生日</view><view class="gentle-note">生日当天，千层蛋糕半价。
{{birthdayPolicy ? '具体适用范围以门店配置为准，演示每年一次。' : '适用范围待门店设置，可先保存生日。'}}</view><view wx:if="{{birthday}}" class="birthday-saved">你的生日：{{birthdayMonth}}<view class="muted">生日已锁定，修改请联系商家。</view></view><block wx:else><picker mode="date" value="{{birthInput || '2000-01-01'}}" end="{{today}}" bindchange="birthChange"><view class="picker-value">{{birthInput || '请选择你的生日'}} ⌄</view></picker><view class="footnote">确认后生日将锁定，请核对日期。</view><button size="mini" class="brown-button wide" bindtap="saveBirthday">保存我的生日</button></block></block>
    <block wx:elif="{{sheet === 'levels'}}"><text class="eyebrow">SWEET ISLAND CLUB</text><view class="page-title">会员等级</view><view class="rules-box" wx:if="{{!rulesConfigured}}">五级名称已确认，升级门槛与折扣尚未确定，当前不执行自动升级和等级折扣。</view><view class="tier-list"><view wx:for="{{tierRules}}" wx:key="name"><text>{{item.name}} · {{item.thresholdText==='待设置'?'门槛待设置':'累计实付 ¥'+item.thresholdText}}</text><text>{{rulesConfigured?item.rateText:'权益待设置'}}</text></view></view><view class="rules-box">演示消费额在订单完成后累计，赠送余额不计入；与其他优惠择优不叠加。正式计算与叠加规则待门店确认。</view></block>
    <block wx:elif="{{sheet === 'ledger'}}"><text class="eyebrow">EVERY SWEET MOMENT COUNTS</text><view class="page-title">余额收支明细</view><view class="wallet-summary">可用 ¥{{balanceText}}<text>本金 ¥{{principalText}} · 赠送 ¥{{bonusText}}</text></view><view class="footnote">这里只记录余额变动，微信模拟支付可在订单中查看。</view><view wx:if="{{!ledger.length}}" class="empty-state muted">暂时没有收支记录</view><view wx:for="{{ledger}}" wx:key="id" class="ledger-row"><view><view>{{item.label}}</view><text class="muted">{{item.date}}</text></view><text>¥{{item.amountText}}</text></view></block>
  </view></view>
  <view wx:if="{{splash}}" class="splash {{splashLeaving ? 'splash-leaving' : ''}}" catchtouchmove="noop" aria-label="甜屿烘焙品牌开屏">
    <button size="mini" class="splash-skip" bindtap="skipSplash">跳过 ›</button><view class="splash-inner"><view class="splash-brand">甜屿烘焙</view><view class="splash-en">SWEET ISLAND BAKERY</view><view class="splash-art"><view class="mascot pose-0 splash-mascot"><image src="/sweet-island-demo/images/mascot-poses.png" mode="scaleToFill"/></view></view><view class="splash-slogan">一层一层，叠满小确幸。</view><view class="splash-line"></view><view class="splash-caption">手作千层 · 认真好吃</view></view>
  </view>
  <view wx:if="{{message}}" class="toast" role="status">{{message}}</view>
</view>
